{
  "name": "my-fitness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "verify": "node scripts/verify.mjs",
    "hygiene": "node scripts/check-repo-hygiene.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@nuxt/ui": "^4.12.0",
    "better-sqlite3": "^13.2.0",
    "chart.js": "^4.6.1",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "pdfjs-dist": "^6.5.438",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild": true,
    "vue-demi": true,
    "better-sqlite3": false
  }
}
