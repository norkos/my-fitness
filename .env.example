# Copy to .env and fill in real values. Never commit .env.

# Login credentials for the single user
NUXT_APP_USERNAME=change-me
NUXT_APP_PASSWORD=change-me

# Secret used to encrypt the session cookie (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_APP_SECRET=replace-with-a-random-string-of-32-plus-chars

# SQLite database file (compose overrides this with /data/fitness.db inside the container)
NUXT_DATABASE_PATH=./data/fitness.db

# Port the server listens on
PORT=3000

# Proxy in front of the app, used to identify clients for the login lockout:
# none (default, direct connections), cloudflare (Cloudflare Tunnel), generic (one reverse proxy, e.g. Railway)
NUXT_TRUSTED_PROXY=none

# Only for local HTTP testing (e.g. phone on home Wi-Fi). Leave unset when hosted (defaults to true).
NUXT_SESSION_COOKIE_SECURE=false
